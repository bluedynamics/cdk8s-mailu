  "devDependencies": {
    "@stylistic/eslint-plugin": "^2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.10",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "cdk8s": "2.70.26",
    "cdk8s-cli": "^2.204.5",
    "cdk8s-plus-33": "2.4.0",
    "commit-and-tag-version": "^12",
    "constructs": "10.4.0",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
