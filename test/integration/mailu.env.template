# Environment of the Mailu containers in the integration test.
# run.sh copies this file and replaces the two @...@ placeholders with random values.
SECRET_KEY=@SECRET_KEY@
INITIAL_ADMIN_PW=@INITIAL_ADMIN_PW@
INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=test.example
INITIAL_ADMIN_MODE=ifmissing
# The compose network 10.42.203.0/24 lies inside, like pods inside a pod network
SUBNET=10.42.0.0/16
REAL_IP_FROM=10.42.0.0/16
REAL_IP_HEADER=X-Forwarded-For
DOMAIN=test.example
HOSTNAMES=mail.test.example
POSTMASTER=admin
TLS_FLAVOR=notls
AUTH_RATELIMIT_IP=60/hour
AUTH_RATELIMIT_USER=100/day
MESSAGE_RATELIMIT=200/day
# Must match the SIZE the front advertises (chart default: 50 MB)
MESSAGE_SIZE_LIMIT=52428800
DISABLE_STATISTICS=True
WEBMAIL=none
ANTIVIRUS=none
API=false
RELAYNETS=
FETCHMAIL_ENABLED=False
RECIPIENT_DELIMITER=+
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
SITENAME=Mailu
WEBSITE=https://mail.test.example
LOG_LEVEL=INFO
TIMEZONE=Etc/UTC
ADMIN_ADDRESS=admin
# Despite its name this is where postfix delivers by LMTP: dovecot
FRONT_ADDRESS=imap
